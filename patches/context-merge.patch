+            `Invalid compressed history reference offset: ${filePath}`,
+          );
+        buffer = buffer.subarray(0, endByteOffset);
+      }
+    } else {
+      const length = endByteOffset ?? before.size;
+      if (!Number.isSafeInteger(length) || length < 0 || length > before.size)
