+              ref,
+              sourceThreadId,
+              ordinal,
+              bytes: Buffer.byteLength(json),
+            })),
+        totalRecords: records.length,
+        offset: options.offset,
+        nextOffset:
+          options.offset + page.length < records.length
+            ? options.offset + page.length
