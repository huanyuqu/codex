+      const value = args[++i];
+      if (
+        !/^[0-9]+$/.test(value ?? "") ||
+        !Number.isSafeInteger(Number(value)) ||
+        (Number(value) === 0 && !["--offset", "--start-byte"].includes(arg))
+      )
