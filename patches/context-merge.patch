+  assert.equal(again.importedItems, 0);
+  assert.equal(again.reusedAnalysis, true);
+  assert.equal(client.calls.filter((c) => c.method === "model").length, 1);
+  assert.equal(
+    client.calls.filter((c) => c.method === "thread/inject_items").length,
