+}
+
+export function parseMergeItem(item) {
+  if (item.type !== "message" || item.role !== "user" || !item.content?.length)
+    return null;
+  const text = item.content[0]?.text;
+  if (typeof text !== "string" || !text.startsWith(MERGE_PREFIX)) return null;
