+      const key = {
+        "--max-bytes": "maxBytes",
+        "--max-tokens": "maxTokens",
+        "--offset": "offset",
+        "--limit": "limit",
+        "--start-byte": "startByte",
+        "--length-bytes": "lengthBytes",
+      }[arg];
+      options[key] = Number(value);
+    } else if (arg.startsWith("-"))
