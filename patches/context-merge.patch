+  const first = await mergeThreads(client, {
+    threadIds: ["a", "b", "c"],
+    semantic: true,
+  });
+  assert.equal(first.analysisExecuted, true);
+  assert.ok(
+    client.calls.findIndex((c) => c.method === "model") <
+      client.calls.findIndex((c) => c.method === "thread/fork"),
+  );
